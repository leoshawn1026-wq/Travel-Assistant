# 复制为 .env 并填入真实密钥（切勿提交到 Git）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

AMAP_API_KEY=your-amap-web-service-key

# JWT 签名密钥（必须独立于 DeepSeek API Key，生产环境务必改为随机字符串）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS 允许的来源（多个用逗号分隔，生产环境填写具体域名）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SQLite 缓存路径
DATABASE_PATH=./data/cache.db

# 速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=10

# API 文档（生产环境关闭）
OPENAPI_ENABLED=false

# （可选）Web 应用数据库 URL — 生产环境切换为 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/travel_web
